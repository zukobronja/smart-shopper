   "source": [
    "# Test Extractability Scoring Fix\n",
    "\n",
    "Quick test to verify the improved extractability scoring after fixing the issue where all results were getting 0.100 extractability scores."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.append('..')\n",
    "\n",
    "from app.agents.credibility_filter_agent import CredibilityFilterAgent\n",
    "\n",
    "# Create agent\n",
    "agent = CredibilityFilterAgent()\n",
    "print(\"✅ CredibilityFilterAgent created\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test extractability scoring with different content types\n",
    "test_cases = [\n",
    "    {\n",
    "        \"name\": \"❌ No content (should score ~0.1)\",\n",
    "        \"url\": \"https://example.com/1\",\n",
    "        \"lookup\": {\"https://example.com/1\": {\"content\": \"No content\"}}\n",
    "    },\n",
    "    {\n",
    "        \"name\": \"⚠️ Short content (should score ~0.4-0.5)\",\n",
    "        \"url\": \"https://example.com/2\", \n",
    "        \"lookup\": {\"https://example.com/2\": {\"content\": \"Gaming laptop for sale\"}}\n",
    "    },\n",
    "    {\n",
    "        \"name\": \"✅ Rich structured content (should score ~0.8-1.0)\",\n",
    "        \"url\": \"https://example.com/3\",\n",
    "        \"lookup\": {\"https://example.com/3\": {\"content\": \"Gaming laptop with Intel processor, 16GB RAM, RTX 4070 graphics card, 1TB storage, 15.6 inch display, high-performance specs for gaming, price $1299, features advanced cooling, premium build quality, excellent review ratings from customers\"}}\n",
    "    }\n",
    "]\n",
    "\n",
    "print(\"🧪 Testing Extractability Scoring:\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "for test_case in test_cases:\n",
    "    score = agent._calculate_extractability_score(test_case[\"url\"], test_case[\"lookup\"])\n",
    "    content = test_case[\"lookup\"][test_case[\"url\"]].get(\"content\", \"\")\n",
    "    \n",
    "    print(f\"\\n{test_case['name']}\")\n",
    "    print(f\"   Content: '{content[:80]}{'...' if len(content) > 80 else ''}'\")\n",
    "    print(f\"   Length: {len(content)} characters\")\n",
    "    print(f\"   Extractability Score: {score:.3f}\")\n",
    "\n",
    "print(\"\\n🎉 Extractability scoring is now working correctly!\")\n",
    "print(\"   - Poor content gets low scores (~0.1)\")\n",
    "print(\"   - Good content gets higher scores (~0.5-1.0)\")\n",
    "print(\"   - Rich structured content gets maximum scores (~1.0)\")"
   ]
  }
 ],
