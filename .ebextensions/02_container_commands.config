container_commands:
  01_configure_nginx_timeout:
    command: |
      # Add timeout configuration to main nginx.conf
      if ! grep -q "proxy_read_timeout 600" /etc/nginx/nginx.conf; then
        sed -i '/http {/a\\tproxy_read_timeout 600s;\n\tproxy_connect_timeout 600s;\n\tproxy_send_timeout 600s;' /etc/nginx/nginx.conf
      fi
      
      # Restart nginx to apply changes
      service nginx reload