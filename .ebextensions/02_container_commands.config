# Container commands for deployment
container_commands:
  01_show_environment:
    command: "echo 'Deployment starting with MongoDB Atlas connection...'"
  02_verify_ssl_certs:
    command: "ls -la /etc/ssl/certs/ca-certificates.crt && echo 'SSL certificates available'"

option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
  aws:elbv2:listener:80:
    Protocol: HTTP
    Rules: default
  aws:elbv2:loadbalancer:
    IdleTimeout: 300