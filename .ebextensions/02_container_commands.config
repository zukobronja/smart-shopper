container_commands:
  01_set_derived_urls:
    command: |
      # Set derived URLs based on FRONTEND_BASE_URL environment variable
      echo "Setting derived environment variables from FRONTEND_BASE_URL: $FRONTEND_BASE_URL"
      
      # Create environment file with derived variables
      cat > /opt/elasticbeanstalk/deployment/env_derived << EOF
      VITE_API_BASE_URL="$FRONTEND_BASE_URL"
      GOOGLE_REDIRECT_URI="$FRONTEND_BASE_URL/auth/google/callback"
      EOF
      
      # Source the derived variables into the current environment
      source /opt/elasticbeanstalk/deployment/env_derived
      
      # Export them so they're available to the application
      export VITE_API_BASE_URL="$FRONTEND_BASE_URL"
      export GOOGLE_REDIRECT_URI="$FRONTEND_BASE_URL/auth/google/callback"
      
      echo "Derived URLs set:"
      echo "  VITE_API_BASE_URL=$VITE_API_BASE_URL"
      echo "  GOOGLE_REDIRECT_URI=$GOOGLE_REDIRECT_URI"