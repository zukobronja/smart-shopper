option_settings:
  aws:elbv2:loadbalancer:
    # Increase ALB idle timeout to 5 minutes (300 seconds)
    # This must be greater than or equal to the backend timeout
    IdleTimeout: 300
  aws:elasticbeanstalk:environment:proxy:
    # Configure proxy server timeout settings
    ProxyServer: nginx
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    # Set static file serving timeout
    /static: static