option_settings:
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.small
  aws:elasticbeanstalk:application:environment:
    PORT: "8000"

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/01_restart_nginx.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Fix nginx upstream configuration
      sed -i 's/${PORT}/8000/g' /var/proxy/staging/nginx/conf.d/elasticbeanstalk-nginx-docker-upstream.conf || true
      /usr/sbin/nginx -t -c /var/proxy/staging/nginx/nginx.conf && service nginx reload || true