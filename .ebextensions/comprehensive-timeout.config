commands:
  01_configure_nginx_timeouts:
    command: |
      cat > /tmp/nginx_timeout.conf << 'EOF'
      # Extended timeout configuration for long-running operations
      proxy_read_timeout 300s;
      proxy_connect_timeout 300s;
      proxy_send_timeout 300s;
      
      # Client timeouts
      client_body_timeout 300s;
      client_header_timeout 300s;
      
      # Keep alive settings
      keepalive_timeout 300s;
      
      # Buffer settings for large responses
      proxy_buffer_size 128k;
      proxy_buffers 4 256k;
      proxy_busy_buffers_size 256k;
      proxy_temp_file_write_size 256k;
      
      # Upstream timeout settings
      upstream_response_timeout 300s;
      EOF
      
      # Copy to nginx config directory
      sudo cp /tmp/nginx_timeout.conf /etc/nginx/conf.d/99-timeout.conf
      
      # Restart nginx to apply changes
      sudo systemctl reload nginx

option_settings:
  aws:elbv2:loadbalancer:
    # ALB idle timeout - must be >= backend timeout
    IdleTimeout: 300
  
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
    
  aws:elasticbeanstalk:command:
    # Increase deployment timeout
    Timeout: 600
    
  aws:autoscaling:launchconfiguration:
    # EC2 instance timeout settings
    BlockDeviceMappings: /dev/xvda=:20:true:gp3