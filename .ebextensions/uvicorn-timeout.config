files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_configure_uvicorn.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Create uvicorn configuration with extended timeouts
      cat > /tmp/uvicorn_config.py << 'EOF'
      # Uvicorn configuration for long-running operations
      import uvicorn
      
      config = uvicorn.Config(
          "backend.app.main:app",
          host="0.0.0.0",
          port=8000,
          workers=1,
          loop="uvloop",
          access_log=True,
          log_level="info",
          # Extended timeout settings
          timeout_keep_alive=300,  # Keep alive timeout
          timeout_graceful_shutdown=30,
      )
      
      if __name__ == "__main__":
          server = uvicorn.Server(config)
          server.run()
      EOF
      
      # Note: This config will be available for manual uvicorn startup if needed

option_settings:
  aws:elasticbeanstalk:container:python:
    # Python-specific timeout settings
    WSGIPath: backend.app.main:app
  
  aws:elasticbeanstalk:application:environment:
    # Environment variable for uvicorn timeout
    UVICORN_TIMEOUT_KEEP_ALIVE: "300"
    UVICORN_GRACEFUL_TIMEOUT: "30"