# SmartShopper Environment Configuration

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Atlas (recommended for development and production)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=smartshopper

# Alternative: Local MongoDB (uncomment if using local-mongo profile)
# MONGODB_URL=mongodb://mongo-local:27017
# DATABASE_NAME=smartshopper

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Google OAuth (optional but recommended)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# Embeddings provider: "openai" (accurate but costs money) or "minilm" (free, good quality)
EMBEDDINGS_PROVIDER=minilm

# Email provider for notifications
EMAIL_PROVIDER=console

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# =============================================================================
# RSS INGESTION (optional)
# =============================================================================
ENABLE_RSS_INGESTION=true
RSS_DEFAULT_POLL_MINUTES=10
RSS_MAX_CONCURRENT_FETCHES=3

# Enhanced RSS Price Extraction
TAVILY_RSS_FEED_INGESTION=false  # Use Tavily for RSS link price extraction (costs Tavily credits)
RSS_ENABLE_WEB_SCRAPING=true     # Enable lightweight web scraping for prices
RSS_SCRAPING_TIMEOUT=5           # Timeout for web scraping in seconds